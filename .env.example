# Geo-Measure API Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Storage & Upload limits
MAX_UPLOAD_MB=50
STORAGE_DIR=uploads

# Database configuration (SQLite by default, Postgres supported)
DATABASE_URL=sqlite:///./geo_measure.db

# Measurement accuracy threshold (percentage difference between projected and geodesic)
DIFF_THRESHOLD_PCT=0.5

# Zip safety constraints
MAX_ZIP_ENTRIES=500
MAX_UNCOMPRESSED_MB=200
